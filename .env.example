# Copy this file to .env and fill in at least one key. Providers are tried
# in the order Google → Groq → OpenAI, falling through when a provider's
# quota is exhausted or its model is deprecated.

# Groq — free tier, get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (optional) — https://aistudio.google.com/app/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# OpenAI (optional) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Optional model overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GOOGLE_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-4o-mini
